# PostgreSQL local (npm run db:local) ou pooler Supabase transaction pour Vercel.
DATABASE_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true&connection_limit=1"
# Migrations : connexion directe ou pooler Supabase SESSION (port 5432).
DIRECT_URL="postgresql://postgres:postgres@localhost:51214/template1?sslmode=disable&pgbouncer=true"
# Uniquement pour la migration initiale depuis Laragon ; ne pas ajouter sur Vercel.
MYSQL_SOURCE_URL=""
# Uniquement pour copier la base locale vers une cible PostgreSQL vide.
MIGRATION_TARGET_URL=""

# Chaîne aléatoire longue utilisée pour les sessions et les CAPTCHA
AUTH_SECRET=""

# À définir uniquement si un proxy de confiance efface puis réécrit cet en-tête.
# Valeurs autorisées : x-forwarded-for ou x-real-ip. Sans cela, seule la limite globale s'applique.
TRUSTED_CLIENT_IP_HEADER=""

# Envoi Brevo : clé API v3 propre à CaveStock, jamais préfixée par NEXT_PUBLIC_
BREVO_API_KEY=""
# Adresse réelle ajoutée et vérifiée comme expéditeur dans Brevo (même si Brevo
# la remplace ensuite par une adresse ...brevosend.com à la réception).
# Ne pas inventer ni saisir ici l'adresse ...brevosend.com générée par Brevo.
BREVO_SENDER_EMAIL=""
# Adresse qui reçoit les messages du formulaire Contact
CAVESTOCK_CONTACT_EMAIL="cavestock-contact@googlegroups.com"
# URL publique exacte du site, obligatoire en production pour les liens de validation
CAVESTOCK_SITE_URL="http://localhost:3100"

# Import différé : même secret (32 caractères aléatoires minimum) sur Vercel et le laptop.
IMPORT_WORKER_TOKEN=""
# Adresse Brevo qui reçoit une notification après chaque dépôt de fichier.
CAVESTOCK_IMPORT_ADMIN_EMAIL=""
# Sur le laptop seulement : URL du site et modèle ChatGPT facultatif (par défaut : gpt-6-luna).
CAVESTOCK_URL=""
CHATGPT_MODEL=""

# Secret aléatoire (au moins 16 caractères) pour protéger la tâche quotidienne Vercel.
# À définir également dans les variables d'environnement du projet Vercel.
CRON_SECRET=""
