{
  "name": "cavestock",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": "24.x" },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:cellar": "node --env-file-if-exists=.env scripts/qa-cellar.mjs",
    "test:menu": "node --env-file-if-exists=.env scripts/qa-menu.mjs",
    "test:import": "node --env-file-if-exists=.env scripts/qa-import.mjs",
    "test:email": "node --env-file-if-exists=.env scripts/qa-email.mjs",
    "test:password": "node --env-file-if-exists=.env scripts/qa-password-reset.mjs",
    "test:retention": "node scripts/qa-account-retention.mjs",
    "test:retention:integration": "node scripts/qa-account-retention-integration.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:local": "prisma dev --name cavestock-postgres --detach",
    "db:mysql-client": "prisma generate --schema prisma/legacy/mysql/schema.prisma",
    "db:import-mysql": "node --env-file=.env scripts/migrate-mysql-to-postgres.mjs",
    "db:copy-postgres": "node --env-file=.env scripts/migrate-mysql-to-postgres.mjs --source=postgres",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "3.0.3",
    "exceljs": "^4.4.0",
    "jose": "6.2.12",
    "lucide-react": "1.46.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "zod": "4.6.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "exceljs": {
      "uuid": "11.1.1"
    }
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "^3.4.0",
    "prisma": "6.19.3",
    "typescript": "5.9.3"
  }
}
